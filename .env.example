# Copie para .env (o spring-dotenv lê esse arquivo) e ajuste. NUNCA commite o .env.
# Precisa ser Base64 (o JwtService decodifica) com pelo menos 32 bytes.
# Gere com: openssl rand -base64 48
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:4200
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# GOOGLE_CLIENT_ID=
